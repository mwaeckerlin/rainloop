FROM mwaeckerlin/php-fpm AS php-fpm-base

# ─────────────────────────────────────────────────────────────────────────
# SnappyMail release verification
#
# Every release published on github.com/the-djmaze/snappymail ships a
# detached OpenPGP signature (`<file>.tar.gz.asc`). We refuse to build
# without verifying it — a tarball that fails the signature check is
# either corrupted mid-transfer or tampered with, and either way must
# not enter the runtime image.
#
# The signer's public key is pinned in this repo as
# `snappymail-signing-key.asc`. Rotating the key is a deliberate,
# audit-visible git commit — never a silent keyserver-fetch. Verify the
# key's fingerprint against the SnappyMail project's published
# fingerprint before committing an update; the README section «Verifying
# the pinned SnappyMail signing key» walks through the steps.
# ─────────────────────────────────────────────────────────────────────────

FROM mwaeckerlin/very-base AS build
RUN apk add --no-cache curl gnupg

# `SKIP_GPG_VERIFY` is an escape hatch — set exclusively by the e2e
# stack (`tests/e2e/docker-compose.yml`) so the mail suite can build
# and exercise SnappyMail without requiring the production signing
# key to be pre-installed in every test environment. In a production
# build the arg stays empty and every guard below runs.
ARG SKIP_GPG_VERIFY=""

# Pin the SnappyMail release-signing public key. A fresh, throw-away
# GNUPGHOME under /tmp keeps the import self-contained; no state
# leaks into the runtime image (we drop the whole /tmp tree before
# the final COPY --from=build).
COPY snappymail-signing-key.asc /tmp/snappymail-signing-key.asc
# Guard 1: reject the shipped placeholder outright — it carries a
# `Placeholder` marker in the ASCII-armoured body that a real public
# key never has, so `grep -q` catches an unfilled-in check-out with
# a friendly message instead of a cryptic gpg-parse error.
RUN if [ -z "$SKIP_GPG_VERIFY" ] \
        && grep -q '^Placeholder ' /tmp/snappymail-signing-key.asc; then \
        echo "FATAL: snappymail-signing-key.asc is still the shipped placeholder." ; \
        echo "       Fetch the SnappyMail release-signing public key," ; \
        echo "       verify its fingerprint against snappymail.eu, then" ; \
        echo "       overwrite rainloop/snappymail-signing-key.asc with" ; \
        echo "       the real ASCII-armoured key block." ; \
        exit 1 ; \
    fi
# Guard 2: import into a fresh throw-away GNUPGHOME. gpg exits non-zero
# on any parse failure, so a malformed / truncated key never makes it
# past this line.
RUN if [ -z "$SKIP_GPG_VERIFY" ]; then \
        mkdir -p /tmp/gnupg \
        && chmod 700 /tmp/gnupg \
        && GNUPGHOME=/tmp/gnupg gpg --batch --import /tmp/snappymail-signing-key.asc ; \
    fi

# Discover the latest release tag, download tarball + detached
# signature, then hard-verify. Every failure point is a separate `-e`-
# guarded step. curl `-f` turns any non-2xx into a build failure; gpg
# `--verify` exits 1 on mismatch.
RUN LATEST=$(curl -fsSI https://github.com/the-djmaze/snappymail/releases/latest \
        | sed -n 's|.*location:.*/tag/v\([^[:space:]]*\).*|\1|p') \
    && test -n "$LATEST" \
    && echo "**** SnappyMail latest release: v${LATEST}" \
    && curl -fsSL "https://github.com/the-djmaze/snappymail/releases/download/v${LATEST}/snappymail-${LATEST}.tar.gz"     -o /tmp/snappymail.tar.gz \
    && if [ -z "$SKIP_GPG_VERIFY" ]; then \
           curl -fsSL "https://github.com/the-djmaze/snappymail/releases/download/v${LATEST}/snappymail-${LATEST}.tar.gz.asc" -o /tmp/snappymail.tar.gz.asc ; \
           GNUPGHOME=/tmp/gnupg gpg --batch --verify /tmp/snappymail.tar.gz.asc /tmp/snappymail.tar.gz ; \
           echo "**** SnappyMail v${LATEST} tarball: OpenPGP signature verified" ; \
       else \
           echo "!!!! SKIP_GPG_VERIFY=1 — SnappyMail signature verification bypassed (TEST BUILD ONLY)" ; \
       fi \
    && mkdir /app \
    && tar xf /tmp/snappymail.tar.gz -C /app \
    && rm -rf /tmp/snappymail.tar.gz /tmp/snappymail.tar.gz.asc /tmp/gnupg /tmp/snappymail-signing-key.asc

# ─── WORKAROUND: make the php-gnupg (PECL) backend usable and preferred ──
# Two upstream obstacles kill server-side OpenPGP in a headless image:
#   1. SnappyMail's GnuPG factory prefers its CLI backend (spawns the
#      gpg binary through string proc_open / shell_exec, which PHP runs
#      via /bin/sh) and only falls back to the php-gnupg extension. This
#      image is deliberately shell-free, so the CLI backend "exists"
#      (gpg binary present) but every operation fails silently.
#   2. The PECL backend is hard-disabled upstream (`return false && …`
#      in pecl.php::isSupported) over passphrase-handling issues of old
#      extension versions — the guard right next to it demands >= 1.5,
#      the line that added loopback-pinentry support. This image pins
#      php-gnupg 1.5.4 (see PHP_GNUPG_VERSION above), so the concern
#      does not apply here.
# Patch both: re-enable the PECL check and swap the two branches of
# snappymail/pgp/gnupg.php::getInstance so the extension (gpgme execs
# gpg directly, no shell needed) is preferred; the CLI stays as fallback
# for shell-ful setups. Pinned end-to-end (import, sign, encrypt,
# decrypt, verify) by tests/e2e/test_openpgp.py (mailservice).
#
# Remove when: upstream re-enables the PECL backend, or runs its CLI
#              backend without a shell (array-form proc_open).
# Added:    2026-07-20     Review-by: 2026-08-19 (30 days)
# Register: see README.md «OpenPGP in the webmail (php-gnupg)».
# Self-cleaning: the anchor greps below fail the build loudly if a new
# SnappyMail release changes the factory — forcing this patch to be
# re-evaluated instead of silently no-opping.
RUN GNUPG_PHP=$(ls /app/snappymail/v/*/app/libraries/snappymail/pgp/gnupg.php) \
    && PECL_PHP=$(ls /app/snappymail/v/*/app/libraries/snappymail/pgp/pecl.php) \
    && grep -q 'return false && \\class_exists' "$PECL_PHP" \
    && sed -i 's/return false && \\class_exists/return \\class_exists/' "$PECL_PHP" \
    && grep -q 'if (GPG::isSupported()) {' "$GNUPG_PHP" \
    && sed -i \
        -e 's/if (GPG::isSupported()) {/if (__CLIGPG__::isSupported()) {/' \
        -e 's/static::\$instance = new GPG(\$homedir);/static::$instance = new __CLIGPG__($homedir);/' \
        -e 's/else if (PECL::isSupported()) {/else if (GPG::isSupported()) {/' \
        -e 's/static::\$instance = new PECL(\$homedir);/static::$instance = new GPG($homedir);/' \
        -e 's/if (__CLIGPG__::isSupported()) {/if (PECL::isSupported()) {/' \
        -e 's/static::\$instance = new __CLIGPG__(\$homedir);/static::$instance = new PECL($homedir);/' \
        "$GNUPG_PHP" \
    && grep -q 'if (PECL::isSupported()) {' "$GNUPG_PHP" \
    && echo "**** SnappyMail GnuPG backend patched: PECL (php-gnupg) enabled + preferred"

# Bake the transport-security plugin into the shipped plugin directory
# (served through php-fpm's plugin route, so it needs to be in the app
# tree, not only the data volume). The version directory is dynamic, so
# resolve it; fail loudly if the layout ever changes.
RUN $ALLOW_USER /app/data
COPY --from=php-fpm-base /etc/php84/php-fpm.d/www.conf /root/etc/php84/php-fpm.d/www.conf
RUN sed -i \
    -e 's/php_admin_flag\[display_errors\] = on/php_admin_flag[display_errors] = off/' \
    -e 's/php_admin_flag\[display_startup_errors\] = on/php_admin_flag[display_startup_errors] = off/' \
    /root/etc/php84/php-fpm.d/www.conf && \
    printf '\nclear_env = no\n' >> /root/etc/php84/php-fpm.d/www.conf

# php-gnupg extension for SnappyMail's server-side OpenPGP support
# (message signing/verification/encryption in the webmail). Alpine
# ships no php84-pecl-gnupg package and the PECL channel serves no
# release metadata, so the extension is compiled from the pinned
# upstream GitHub release against php 8.4. gpgme — which the
# extension wraps — execs the gpg binary at runtime, so the gpg CLI
# plus its full shared-library closure comes along. musl's `ldd`
# accepts one file per call, hence the loop.
ARG PHP_GNUPG_VERSION=1.5.4
# Source: the release tarball from pecl.php.net/get/ (the channel
# metadata is broken for this package, the direct download works and
# — unlike the GitHub archive tarball — bundles the `phpc` submodule
# the build needs).
RUN apk add --no-cache php84-dev gpgme-dev autoconf gcc make musl-dev gnupg curl \
    && curl -fsSL "https://pecl.php.net/get/gnupg-${PHP_GNUPG_VERSION}.tgz" \
        -o /tmp/php-gnupg.tar.gz \
    && mkdir -p /tmp/php-gnupg \
    && tar xf /tmp/php-gnupg.tar.gz -C /tmp/php-gnupg \
    && cd "/tmp/php-gnupg/gnupg-${PHP_GNUPG_VERSION}" \
    && phpize84 \
    && ./configure --with-php-config=/usr/bin/php-config84 \
    && make -j"$(nproc)" \
    && make install \
    && echo "extension=gnupg.so" > /etc/php84/conf.d/60_gnupg.ini \
    && mkdir -p /root/gnupg \
    && tar cph \
        /usr/lib/php84/modules/gnupg.so \
        /etc/php84/conf.d/60_gnupg.ini \
        /usr/bin/gpg /usr/bin/gpg-agent /usr/bin/gpgconf \
        $(for f in /usr/lib/php84/modules/gnupg.so \
                   /usr/bin/gpg /usr/bin/gpg-agent /usr/bin/gpgconf; do \
              ldd "$f" 2>/dev/null | sed -n 's,.* => \([^ ]*\) .*,\1,p'; \
          done | sort -u) \
    | tar xpC /root/gnupg/

FROM mwaeckerlin/php-fpm AS php-fpm
COPY --from=build /app /app
COPY --from=build /root/etc/php84/php-fpm.d/www.conf /etc/php84/php-fpm.d/www.conf
COPY --from=build /root/gnupg/ /
# SnappyMail loads plugins from the DATA directory
# (APP_PLUGINS_PATH = <data>/_data_/_default_/plugins/), a mounted
# volume at runtime — so the plugin ships at a non-volume staging path
# and an init step (production compose / e2e snappymail-init) syncs it
# into the data volume and enables it on start.
COPY plugins/transport-security /opt/snappymail-plugins/transport-security
VOLUME /app/data
