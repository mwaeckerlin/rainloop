FROM mwaeckerlin/very-base AS build
RUN apk add --no-cache curl \
    && for v in $(curl -fsS https://github.com/the-djmaze/snappymail/releases.atom \
            | sed -n 's|.*/releases/tag/v\([^"<]*\)".*|\1|p'); do \
        if curl -fsSIL -o /dev/null "https://github.com/the-djmaze/snappymail/releases/download/v${v}/snappymail-${v}.tar.gz"; then \
            LATEST="$v"; break; \
        fi; \
        echo "**** SnappyMail v${v} carries no tarball, trying the release before"; \
    done \
    && test -n "$LATEST" \
    && echo "**** SnappyMail latest release: v${LATEST}" \
    && curl -fsSL "https://github.com/the-djmaze/snappymail/releases/download/v${LATEST}/snappymail-${LATEST}.tar.gz" -o /tmp/snappymail.tar.gz \
    && mkdir /app \
    && tar xf /tmp/snappymail.tar.gz -C /app \
    && rm /tmp/snappymail.tar.gz

FROM mwaeckerlin/nginx AS nginx
ENV PHP_FPM_HOST="snappymail"
COPY --from=build /app /app
