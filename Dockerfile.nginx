# Static-file side of the SnappyMail split: nginx serves the app tree
# (all JavaScript the browser executes), php-fpm (Dockerfile.php-fpm)
# runs the backend. The SAME release-signature verification applies
# here — a tampered tarball in this image would serve malicious
# JavaScript to every webmail user. Key pinning and guards mirror
# Dockerfile.php-fpm; the pinned key lives in
# `snappymail-signing-key.asc` (see the README section «Verifying the
# pinned SnappyMail signing key»).
FROM mwaeckerlin/very-base AS build
RUN apk add --no-cache curl gnupg

# `SKIP_GPG_VERIFY` is an escape hatch — set exclusively by test
# stacks (mailservice e2e, local compose) that ship the placeholder
# signing key. In a production build the arg stays empty and every
# guard below runs.
ARG SKIP_GPG_VERIFY=""

COPY snappymail-signing-key.asc /tmp/snappymail-signing-key.asc
# Guard 1: reject the shipped placeholder outright (see
# Dockerfile.php-fpm for the rationale).
RUN if [ -z "$SKIP_GPG_VERIFY" ] \
        && grep -q '^Placeholder ' /tmp/snappymail-signing-key.asc; then \
        echo "FATAL: snappymail-signing-key.asc is still the shipped placeholder." ; \
        echo "       Fetch the SnappyMail release-signing public key," ; \
        echo "       verify its fingerprint against snappymail.eu, then" ; \
        echo "       overwrite rainloop/snappymail-signing-key.asc with" ; \
        echo "       the real ASCII-armoured key block." ; \
        exit 1 ; \
    fi
# Guard 2: import into a fresh throw-away GNUPGHOME.
RUN if [ -z "$SKIP_GPG_VERIFY" ]; then \
        mkdir -p /tmp/gnupg \
        && chmod 700 /tmp/gnupg \
        && GNUPGHOME=/tmp/gnupg gpg --batch --import /tmp/snappymail-signing-key.asc ; \
    fi

# Discover the latest release tag, download tarball + detached
# signature, then hard-verify. curl `-f` turns any non-2xx into a
# build failure; `test -n` catches an empty tag from a changed
# redirect; gpg `--verify` exits 1 on mismatch.
RUN LATEST=$(curl -fsSI https://github.com/the-djmaze/snappymail/releases/latest \
        | sed -n 's|.*location:.*/tag/v\([^[:space:]]*\).*|\1|p') \
    && test -n "$LATEST" \
    && echo "**** SnappyMail latest release: v${LATEST}" \
    && curl -fsSL "https://github.com/the-djmaze/snappymail/releases/download/v${LATEST}/snappymail-${LATEST}.tar.gz"     -o /tmp/snappymail.tar.gz \
    && if [ -z "$SKIP_GPG_VERIFY" ]; then \
           curl -fsSL "https://github.com/the-djmaze/snappymail/releases/download/v${LATEST}/snappymail-${LATEST}.tar.gz.asc" -o /tmp/snappymail.tar.gz.asc ; \
           GNUPGHOME=/tmp/gnupg gpg --batch --verify /tmp/snappymail.tar.gz.asc /tmp/snappymail.tar.gz ; \
           echo "**** SnappyMail v${LATEST} tarball: OpenPGP signature verified" ; \
       else \
           echo "!!!! SKIP_GPG_VERIFY=1 — SnappyMail signature verification bypassed (TEST BUILD ONLY)" ; \
       fi \
    && mkdir /app \
    && tar xf /tmp/snappymail.tar.gz -C /app \
    && rm -rf /tmp/snappymail.tar.gz /tmp/snappymail.tar.gz.asc /tmp/gnupg /tmp/snappymail-signing-key.asc

FROM mwaeckerlin/nginx AS nginx
ENV PHP_FPM_HOST "snappymail"
COPY --from=build /app /app
